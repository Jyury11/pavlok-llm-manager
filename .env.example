# LINE
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
ALLOWED_LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Pavlok
PAVLOK_ACCESS_TOKEN=your_pavlok_access_token

# Server
PORT=8080

# Database
# DB_TYPE: "sqlite" (local) or "firestore" (GCP)
DB_TYPE=sqlite
SQLITE_PATH=./data.db
# GCP_PROJECT_ID is required when DB_TYPE=firestore
GCP_PROJECT_ID=

# Safety
MAX_DAILY_SHOCKS=10
MAX_HOURLY_SHOCKS=3
SHOCK_LEVEL=50
QUIET_HOURS_START=23
QUIET_HOURS_END=6

# Daily Review
# REVIEW_HOUR: Hour to send daily review (24-hour format, default: 21)
# REVIEW_MINUTE: Minute to send daily review (default: 0)
# REVIEW_ENABLE: Enable/disable daily review feature (true/false, default: true)
REVIEW_HOUR=21
REVIEW_MINUTE=0
REVIEW_ENABLE=true
